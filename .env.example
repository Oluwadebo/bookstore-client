# Copy to ".env" if you need to change these. Never put secrets here:
# anything starting with VITE_ is public and visible in the browser.

# Base URL of the API.
# Leave EMPTY in development: Vite proxies /api to http://localhost:5000.
# In production set it to the live API address, e.g. https://api.yourstore.com
VITE_API_URL=
